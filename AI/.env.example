# IELTS Platform AI Evaluation & RAG Pipeline Configuration
# Copy this file to .env and provide your local or cloud keys

# AI Provider for evaluation benchmarks (openai, groq, gemini, or local)
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
AI_MODEL_NAME=gpt-4o-mini
AI_API_BASE_URL=https://api.openai.com/v1

# Embedding model for vector indexing
EMBEDDING_PROVIDER=local_or_cloud
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# Spring Boot Chatbot Endpoint for End-to-End Evaluation
CHATBOT_API_URL=http://localhost:8080/api/v1/chat
AUTH_BEARER_TOKEN=

# IELTS AI Training Engine - Environment Variables
# Copy this file to .env and adjust as needed

# Base Model settings
BASE_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
MODEL_CACHE_DIR=models/base
OUTPUT_DIR=outputs

# Hardware preferences (cpu, cuda, auto)
DEVICE=auto
USE_4BIT=false
USE_8BIT=false

# Wandb or logging (optional, default disabled)
WANDB_DISABLED=true
WANDB_PROJECT=ielts-ai-training

# Random seed
SEED=42

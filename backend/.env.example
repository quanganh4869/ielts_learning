# =============================================================================
# IELTS Learning Platform - Backend Environment Template (.env.example)
# Copy this file to .env and provide your actual credentials.
# DO NOT commit the .env file with real secrets to version control.
# =============================================================================

# Server
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Connection (Production / Local)
DB_URL=jdbc:postgresql://localhost:5432/ielts_platform
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# Google OAuth 2.0 / OpenID Connect (Obtained from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Administrator Policy Configuration
# Set to your authorized admin Google email (e.g., your_email@gmail.com)
APP_ADMIN_EMAIL=your_admin_email_here@gmail.com

# Application URLs & CORS
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Session & Cookie Security
# Set to true when running behind HTTPS in staging/production
APP_AUTH_COOKIE_SECURE=false
APP_SESSION_TTL=86400

# JWT Secrets (For Bearer API Token fallback if needed)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# IELTS Learning Platform - Backend Configuration

# Server Port
PORT=8080

# Spring Active Profile (local, test, prod)
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Database Connection
DB_URL=jdbc:postgresql://localhost:5432/ielts_platform
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Security Secrets (Must be at least 256 bits / 32 bytes base64 encoded for HMAC-SHA256)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Whitelist (Comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional: Google OAuth2 Client ID for Supabase / Google Identity Verification
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# =============================================================================
# IELTS Learning Platform - Backend Environment Template (.env.example)
# Copy this file to .env and provide your actual credentials.
# DO NOT commit the .env file with real secrets to version control.
# =============================================================================

# Server
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Connection (Supabase PostgreSQL / Local)
# For Supabase PostgreSQL, use the Transaction / Session Pooler URL from Supabase Settings -> Database
DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres.your-project-ref
DB_PASSWORD=your_database_password_here

# Administrator Policy Configuration
# Set to your authorized admin Google email (e.g. your_email@gmail.com)
APP_ADMIN_EMAIL=your_admin_email_here@gmail.com

# Supabase Auth Configuration (Resource Server JWT Verification)
# SUPABASE_URL: Base URL of your Supabase project (e.g., https://your-project-ref.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_JWKS_URI: Optional override for JWKS (defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json)
SUPABASE_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET: Legacy symmetric HMAC secret from Supabase API Settings (used if JWKS is not configured)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Expected JWT audience
SUPABASE_AUDIENCE=authenticated

# Cloudflare R2 Storage (S3-Compatible) Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=ielts-platform-storage
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_ENDPOINT defaults to https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
# Optional public CDN / custom domain prefix for public course assets
R2_PUBLIC_URL_PREFIX=https://cdn.yourdomain.com
R2_UPLOAD_TTL_SECONDS=600
R2_DOWNLOAD_TTL_SECONDS=900

# Application URLs & CORS
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Session & Cookie Security (Set to true when running behind HTTPS in staging/production)
APP_AUTH_COOKIE_SECURE=false
